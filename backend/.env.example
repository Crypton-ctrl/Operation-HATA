# ============================================================
# OPERATION HATA - Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# --- Application ---
SECRET_KEY=change-this-to-a-long-random-string
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Console login ---
# Single shared password used to log into the HATA dashboard. Change this.
ACCESS_PASSWORD=operationhata

# --- Database ---
# SQLite (default, zero-config, used for local dev/demo):
DATABASE_URL=sqlite:///./hata.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://hata_user:password@localhost:5432/hata_db

# --- Gmail (OAuth2 - preferred) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/emails/oauth/callback

# --- Gmail (IMAP fallback - app password, never store raw passwords) ---
# If OAuth is not configured, IMAP with an app-specific password can be used.
# The password is encrypted at rest using SECRET_KEY (Fernet), never stored plaintext.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- AI Provider (Anthropic Claude) ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Optional reputation service ---
VIRUSTOTAL_API_KEY=

# --- Scanner limits ---
MAX_UPLOAD_MB=25
EMAIL_POLL_SECONDS=60

# --- External tool paths (leave blank to auto-detect on PATH) ---
TESSERACT_CMD=
EXIFTOOL_CMD=
