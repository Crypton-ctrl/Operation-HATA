# Copy to .env and set when the backend is hosted on a different domain
# than the frontend (e.g. Render, Railway, Vercel + separate API host).
# Leave both unset for local development - the Vite dev server proxy
# (see vite.config.js) handles same-origin routing to localhost:8000 instead.

# Full base URL of the deployed backend's API, including /api
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api

# Full WebSocket URL of the deployed backend
VITE_WS_URL=wss://your-backend-service.onrender.com/ws
